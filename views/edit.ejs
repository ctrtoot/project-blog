<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Sửa bài viết</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

<div class="container">
    <h1>✏️ Sửa bài viết</h1>

    <div class="form-card">
        <form action="/blogposts/<%= post._id %>/update" method="POST">

    <label>Tiêu đề</label>
            <input type="text" name="title" value="<%= post.title %>" required>

            <label>Nội dung</label>
            <textarea name="body" required><%= post.body %></textarea>

            <label>Tags</label>
            <input type="text" name="tags" value="<%= post.tags.join(', ') %>">

            <button>Cập nhật</button>

        </form>
    </div>

    <a href="/">⬅ Quay lại</a>
</div>

</body>
</html>