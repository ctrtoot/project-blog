<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Tạo bài viết</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

<div class="container">
    <h1>✍️ Tạo bài viết</h1>

    <div class="form-card">
       <form action="/blogposts/store" method="POST">

            <label>Tiêu đề</label>
            <input type="text" name="title" required>

            <label>Nội dung</label>
            <textarea name="body" required></textarea>

            <label>Tags</label>
            <input type="text" name="tags" placeholder="VD: nodejs, mongodb">

           <button type="submit" onclick="this.disabled=true; this.form.submit();">Lưu bài viết</button>

        </form>
    </div>

    <a href="/">⬅ Quay lại</a>
</div>

</body>
</html>